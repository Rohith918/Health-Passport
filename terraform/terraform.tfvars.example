# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it if it ever holds secrets.

aws_region   = "us-east-1"
project_name = "health-passport"
environment  = "prod"

github_repo = "your-org/health-passport-dashboard" # org/repo, no https://

# Cost dials — see variables.tf for what each one trades off
node_instance_type = "t3.medium"
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
single_nat_gateway  = true
